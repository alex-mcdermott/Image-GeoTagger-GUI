<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls">

  <Styles.Resources>
    <SolidColorBrush x:Key="GeoSavedBrush" Color="#1F6FD1" />
    <SolidColorBrush x:Key="GeoPendingBrush" Color="#F7630C" />
    <SolidColorBrush x:Key="GeoRemovalBrush" Color="#C42B1C" />
  </Styles.Resources>

  <!-- Cards: the WinUI "layer on Mica" look. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="Border.floating">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="0 4 12 0 #33000000" />
  </Style>

  <Style Selector="TextBlock.cardHeader">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Borderless "subtle" buttons, like WinUI command bar items. -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.subtle:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Map overlay buttons. -->
  <Style Selector="Button.mapButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Filmstrip thumbnails. -->
  <Style Selector="ListBox.filmstrip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,0,6,6" />
  </Style>
  <Style Selector="ListBox.filmstrip ListBoxItem">
    <Setter Property="Padding" Value="5" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.filmstrip ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="Border.thumbFrame">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="ListBox.filmstrip ListBoxItem:selected Border.thumbFrame">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Background" Value="{StaticResource GeoSavedBrush}" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #55000000" />
  </Style>
  <Style Selector="Border.badge.pending">
    <Setter Property="Background" Value="{StaticResource GeoPendingBrush}" />
  </Style>
  <Style Selector="Border.badge.removal">
    <Setter Property="Background" Value="{StaticResource GeoRemovalBrush}" />
  </Style>

  <Style Selector="Border.formatTag">
    <Setter Property="Background" Value="#99000000" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,1" />
  </Style>
  <Style Selector="Border.formatTag > TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
